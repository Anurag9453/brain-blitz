# Copy this file to .env and fill in values from your Supabase project:
# Dashboard → Project Settings → Data API (URL) and API Keys (anon/publishable).
# EXPO_PUBLIC_ vars are bundled into the client — only ever put the PUBLIC key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
